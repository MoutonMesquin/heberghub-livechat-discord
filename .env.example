# --- Obligatoire -----------------------------------------------------------
# Sites autorisés à afficher le widget (origines exactes, séparées par des virgules)
ALLOWED_ORIGINS=https://www.example.com,https://example.com

# Bot Discord (https://discord.com/developers/applications) — ne jamais committer
DISCORD_TOKEN=
# Identifiants (mode développeur Discord > clic droit > Copier l'identifiant)
DISCORD_GUILD_ID=
DISCORD_FORUM_CHANNEL_ID=
DISCORD_SUPPORT_ROLE_ID=

# --- Réseau ----------------------------------------------------------------
PORT=3000
# Nombre TOTAL de sauts devant le serveur : 1 derrière un proxy inverse seul,
# 2 derrière un tunnel (ex. Cloudflare Tunnel) puis un proxy inverse.
# Ou liste des adresses de ces proxys. 0 = connexion directe (X-Forwarded-For ignoré).
TRUST_PROXY=1

# --- Comportement ----------------------------------------------------------
# Préfixe des messages internes à l'équipe, non transmis au visiteur
INTERNAL_PREFIX=!
# Afficher le widget même si aucun membre du support n'est en ligne
ALWAYS_AVAILABLE=false
# IP du visiteur dans le fil Discord : none | masked | full
VISITOR_IP_IN_DISCORD=none
TIMEZONE=Europe/Paris
MAX_MESSAGE_LENGTH=2000
SESSION_TTL_MINUTES=30
DISCONNECT_GRACE_SECONDS=120
DEMO_PAGE=false

# --- Anti-abus -------------------------------------------------------------
RATE_MESSAGES_PER_MINUTE=10
RATE_MESSAGE_BURST=5
RATE_THREADS_PER_IP_PER_HOUR=3
RATE_THREADS_GLOBAL_PER_HOUR=60
MAX_CONNECTIONS_PER_IP=10

# --- Journaux --------------------------------------------------------------
LOG_LEVEL=info
# true = le texte des messages apparaît dans les journaux (déconseillé)
LOG_MESSAGES=false
